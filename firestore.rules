rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomExists(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isHost(roomId) {
      return signedIn() && roomExists(roomId) &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid;
    }

    function validRoom(data) {
      return data.hostId is string
        && data.mode in ['music', 'video', 'mixed']
        && data.status in ['waiting', 'playing', 'paused']
        && data.currentItemId is string
        && data.position is number
        && data.position >= 0
        && data.queue is list
        && data.queue.size() <= 50;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && validRoom(request.resource.data)
        && request.resource.data.status == 'waiting'
        && request.resource.data.currentItemId == ''
        && request.resource.data.position == 0;

      allow update: if isHost(roomId)
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.mode == resource.data.mode
        && validRoom(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'currentItemId', 'queue', 'position', 'updatedAt', 'version'
        ]);

      allow delete: if isHost(roomId);

      match /participants/{userId} {
        allow read: if signedIn() && roomExists(roomId);

        allow create: if signedIn()
          && roomExists(roomId)
          && userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 32
          && request.resource.data.joinedAt is number;

        allow update: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 32;

        allow delete: if signedIn() && (userId == request.auth.uid || isHost(roomId));
      }

      match /messages/{messageId} {
        allow read: if signedIn() && roomExists(roomId);

        allow create: if signedIn()
          && roomExists(roomId)
          && request.resource.data.keys().hasOnly(['userId', 'name', 'text', 'createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 280
          && request.resource.data.createdAt is number;

        allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }
  }
}
